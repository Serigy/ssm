{
  "name": "mfe-runtime",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mfe-runtime/src",
  "projectType": "library",
  "tags": ["scope:frontend", "type:platform"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/mfe-runtime/tsconfig.json --noEmit" }
    },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint libs/mfe-runtime/src" } },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root libs/mfe-runtime --passWithNoTests" }
    }
  }
}
