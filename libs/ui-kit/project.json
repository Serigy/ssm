{
  "name": "ui-kit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-kit/src",
  "projectType": "library",
  "tags": ["scope:frontend", "type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/ui-kit/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/ui-kit/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root libs/ui-kit --passWithNoTests" }
    }
  }
}
