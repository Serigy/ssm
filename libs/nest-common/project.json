{
  "name": "nest-common",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/nest-common/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:platform"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/nest-common/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/nest-common/src" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --root libs/nest-common --passWithNoTests" }
    }
  }
}
