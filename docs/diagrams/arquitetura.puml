@startuml arquitetura
' O GitHub não renderiza PlantUML: depois de editar, gere o SVG com `make diagrams`.
skinparam defaultFontName sans-serif
skinparam shadowing false
skinparam componentStyle rectangle

package "Navegador" {
  [shell] as shell
  package "Módulos carregados em runtime" {
    [Financeiro] as mfeFinanceiro
    [Pessoas] as mfePessoas
    [Jurídico] as mfeJuridico
    [Operações] as mfeOperacoes
  }
}

package "Cloudflare" {
  package "Workers" {
    [gateway] as gateway
    [identity] as identity
    [financial] as financial
    [hr] as hr
    [legal] as legal
    [operations] as operations
  }

  queue "Queues (eventos)" as queues
  storage "R2 (documentos)" as r2
  collections "KV (tokens revogados)" as kv
  component "Durable Object (coordenação)" as coordinator
}

database "Neon (Postgres)" as neon

shell --> mfeFinanceiro
shell --> mfePessoas
shell --> mfeJuridico
shell --> mfeOperacoes
shell --> gateway : /api/v1/status
shell --> identity : /api
shell --> financial : /api
shell --> hr : /api
shell --> legal : /api
shell --> operations : /api

identity --> neon
financial --> neon
hr --> neon
legal --> neon
operations --> neon

financial --> queues
hr --> queues
legal --> queues
operations --> queues

legal --> r2
identity --> kv
gateway --> coordinator
@enduml
