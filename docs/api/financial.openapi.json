      "InvoiceDto": {
        "type": "object",
        "properties": {}
      },
      "CreateInvoiceDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateInvoiceDto": {
        "type": "object",
        "properties": {}
      },
      "RecordPaymentDto": {
        "type": "object",
        "properties": {}
      },
      "VoidInvoiceDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
