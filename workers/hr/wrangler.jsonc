// ssm-hr · Cloudflare Worker
//
// Três ambientes: o padrão é `dev` e roda inteiro no Miniflare, sem tocar a
// conta. `hmg` e `prd` são reais, com bancos, filas e namespaces separados —
// os ids são preenchidos por scripts/cf-provision.sh.
//
//   pnpm --filter @ssm/worker-hr dev
//   pnpm --filter @ssm/worker-hr deploy:hmg
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssm-hr-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "dev": {
    "port": 8803,
    "local_protocol": "http"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ENVIRONMENT": "dev",
    "SERVICE_NAME": "hr-worker",
    "JWT_ISSUER": "http://localhost:8801",
    "JWT_AUDIENCE": "ssm",
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_SECONDS": "1209600",
    "CORS_ORIGINS": "http://localhost:4200"
  },
  // Banco: Neon, via Hyperdrive (ADR 0014). Em dev o wrangler não passa pelo
  // Hyperdrive: conecta direto na URL de CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE,
  // que scripts/cf-devvars.sh grava no .env (e não no .dev.vars: o wrangler lê do
  // ambiente) a partir de secrets/local/neon_hr_url.
  // O `id` abaixo só precisa ser um UUID bem formado em dev; não existe na conta.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local-shared"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ssm-documents-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Coordinator"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE_IDENTITY",
        "queue": "ssm-identity-dev"
      },
      {
        "binding": "QUEUE_FINANCIAL",
        "queue": "ssm-financial-dev"
      },
      {
        "binding": "QUEUE_HR",
        "queue": "ssm-hr-dev"
      },
      {
        "binding": "QUEUE_LEGAL",
        "queue": "ssm-legal-dev"
      },
      {
        "binding": "QUEUE_OPERATIONS",
        "queue": "ssm-operations-dev"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  },
  "env": {
    "hmg": {
      "name": "ssm-hr-hmg",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "hmg",
        "SENTRY_DSN": "https://c57ffbaf3bbdbe0bfadc227e4cf4dfaf@o4504600654118912.ingest.us.sentry.io/4512357145378816",
        "SERVICE_NAME": "hr-worker",
        "JWT_ISSUER": "https://hmg-ssm.serigy.net",
        "JWT_AUDIENCE": "ssm",
        "ACCESS_TOKEN_TTL_SECONDS": "900",
        "REFRESH_TOKEN_TTL_SECONDS": "1209600",
        "CORS_ORIGINS": "https://hmg-ssm.serigy.net"
      },
      // PENDENTE: o Hyperdrive de hmg ainda não existe. Criar com o papel
      // ssm_hr (ver workers/migrations/postgres/README.md) e trocar o id.
      // Enquanto o marcador estiver aqui, o deploy desse ambiente está impedido:
      // o id não existe na conta e a API da Cloudflare o recusa. (O --dry-run
      // do wrangler NÃO pega isso; só o deploy de verdade.)
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "PENDENTE-CRIAR-HYPERDRIVE-HMG"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "bf95ed276201405d89bc84f0bf00c80c"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "ssm-documents-hmg"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
            "script_name": "ssm-gateway-hmg"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "QUEUE_IDENTITY",
            "queue": "ssm-identity-hmg"
          },
          {
            "binding": "QUEUE_FINANCIAL",
            "queue": "ssm-financial-hmg"
          },
          {
            "binding": "QUEUE_HR",
            "queue": "ssm-hr-hmg"
          },
          {
            "binding": "QUEUE_LEGAL",
            "queue": "ssm-legal-hmg"
          },
          {
            "binding": "QUEUE_OPERATIONS",
            "queue": "ssm-operations-hmg"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/1 * * * *"
        ]
      },
      "routes": [
        {
          "pattern": "hmg-ssm.serigy.net/api/hr/*",
          "zone_name": "serigy.net"
        }
      ]
    },
    "prd": {
      "name": "ssm-hr",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "prd",
        "SENTRY_DSN": "https://c57ffbaf3bbdbe0bfadc227e4cf4dfaf@o4504600654118912.ingest.us.sentry.io/4512357145378816",
        "SERVICE_NAME": "hr-worker",
        "JWT_ISSUER": "https://ssm.serigy.net",
        "JWT_AUDIENCE": "ssm",
        "ACCESS_TOKEN_TTL_SECONDS": "900",
        "REFRESH_TOKEN_TTL_SECONDS": "1209600",
        "CORS_ORIGINS": "https://ssm.serigy.net"
      },
      // PENDENTE: o Hyperdrive de prd ainda não existe. Criar com o papel
      // ssm_hr (ver workers/migrations/postgres/README.md) e trocar o id.
      // Enquanto o marcador estiver aqui, o deploy desse ambiente está impedido:
      // o id não existe na conta e a API da Cloudflare o recusa. (O --dry-run
      // do wrangler NÃO pega isso; só o deploy de verdade.)
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "PENDENTE-CRIAR-HYPERDRIVE-PRD"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "8cad42a3ede44ea29f2d87cdeac29447"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "ssm-documents"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
            "script_name": "ssm-gateway"
          }
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "QUEUE_IDENTITY",
            "queue": "ssm-identity"
          },
          {
            "binding": "QUEUE_FINANCIAL",
            "queue": "ssm-financial"
          },
          {
            "binding": "QUEUE_HR",
            "queue": "ssm-hr"
          },
          {
            "binding": "QUEUE_LEGAL",
            "queue": "ssm-legal"
          },
          {
            "binding": "QUEUE_OPERATIONS",
            "queue": "ssm-operations"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/1 * * * *"
        ]
      },
      "routes": [
        {
          "pattern": "ssm.serigy.net/api/hr/*",
          "zone_name": "serigy.net"
        }
      ]
    }
  }
}
