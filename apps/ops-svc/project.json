{
  "name": "ops-svc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ops-svc/src",
  "projectType": "application",
  "tags": [
    "scope:backend",
    "module:operations"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build -p apps/ops-svc/tsconfig.build.json && tsc-alias -p apps/ops-svc/tsconfig.build.json",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest start --watch -p apps/ops-svc/tsconfig.build.json",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/ops-svc/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/ops-svc/src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root apps/ops-svc --passWithNoTests"
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "SSM_EMIT_OPENAPI=docs/api/operations.openapi.json SSM_SECRETS_DIR=secrets/local node apps/ops-svc/dist/apps/ops-svc/src/main.js",
        "cwd": "."
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f docker/service.Dockerfile --build-arg APP=ops-svc -t ssm/ops-svc:dev .",
        "cwd": "."
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "SSM_SECRETS_DIR=secrets/local tsx node_modules/typeorm/cli.js migration:run -d apps/ops-svc/src/database/data-source.ts",
        "cwd": "."
      }
    }
  }
}
