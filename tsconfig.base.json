{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@ssm/contracts": ["libs/contracts/src/index.ts"],
      "@ssm/nest-common": ["libs/nest-common/src/index.ts"],
      "@ssm/nest-common/zen-preload": ["libs/nest-common/src/security/zen-preload.ts"],
      "@ssm/ui-kit": ["libs/ui-kit/src/index.ts"],
      "@ssm/mfe-runtime": ["libs/mfe-runtime/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
